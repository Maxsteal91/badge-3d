{
  "name": "badge-3d",
  "version": "0.1.0",
  "description": "Draggable 3D conference badge with a physics lanyard (React Three Fiber + Rapier). Drop-in <script> or React component.",
  "license": "MIT",
  "author": "Maxsteal91",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maxsteal91/badge-3d.git"
  },
  "homepage": "https://Maxsteal91.github.io/badge-3d/",
  "bugs": {
    "url": "https://github.com/Maxsteal91/badge-3d/issues"
  },
  "keywords": [
    "badge",
    "lanyard",
    "3d",
    "three",
    "react-three-fiber",
    "rapier",
    "webgl",
    "business-card",
    "portfolio"
  ],
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "exports": {
    ".": {
      "import": "./dist/lib/index.js"
    },
    "./standalone": "./dist/standalone/badge.js",
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/standalone/badge.js",
  "jsdelivr": "./dist/standalone/badge.js",
  "files": [
    "dist/lib",
    "dist/standalone",
    "src/assets/fonts/OFL-Geist.txt"
  ],
  "sideEffects": [
    "./dist/standalone/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:standalone",
    "build:lib": "vite build --mode lib",
    "build:standalone": "vite build --mode standalone",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview --mode demo",
    "lint": "oxlint",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  }
}
